{
  "name": "@reviewpilot/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "cli": "node dist/cli.js",
    "migrate:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:cli": "tsx --env-file-if-exists=.env src/cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/formbody": "9.0.1",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "8.3.0",
    "@prisma/client": "6.19.3",
    "fastify": "5.6.1",
    "nodemailer": "7.0.10",
    "pino": "9.13.1",
    "prisma": "6.19.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "@types/nodemailer": "7.0.3",
    "pino-pretty": "13.1.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
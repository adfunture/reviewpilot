// ReviewPilot – Datenmodell
// Grundsätze: UUIDs als interne IDs, Shopify-IDs separat, Mandantentrennung über shopId,
// eindeutige Constraints gegen doppelte Kampagnen/Einladungen/Webhooks/Jobs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum DeliveryStatus {
  ORDER_RECEIVED
  PROCESSING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  DELIVERY_UNKNOWN
  DELAYED
  FAILED
  CANCELLED
  RETURNED
}

enum DeliverySource {
  SHOPIFY
  CARRIER_API
  MANUAL
}

enum SalesChannel {
  IDEALO
  GOOGLE_SHOPPING
  GOOGLE_ADS
  GOOGLE_ORGANIC
  GEIZHALS
  BILLIGER
  DIRECT
  EMAIL
  SOCIAL
  OTHER
  UNKNOWN
}

enum AttributionConfidence {
  HIGH
  MEDIUM
  LOW
  NONE
}

enum ShippingRule {
  TRACKED // Variante A: ab bestätigter Zustellung
  UNTRACKED_FALLBACK // Variante B: ab Bestellerstellung (Spedition / kein Tracking)
}

enum CampaignStatus {
  PENDING
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  REVIEW_RECEIVED
  CONSENT_MISSING
  REVIEW_STATUS_UNKNOWN
}

enum ReviewStatus {
  UNKNOWN // Status nicht abrufbar – NICHT als „nicht bewertet“ behandeln
  NOT_REVIEWED // nachweislich (per API) keine Bewertung
  REVIEWED
}

enum InvitationStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
  SKIPPED
  CANCELLED
}

enum PlatformKey {
  GOOGLE_CUSTOMER_REVIEWS
  GOOGLE_BUSINESS
  IDEALO
  TRUSTED_SHOPS
  TRUSTPILOT
  JUDGEME
}

enum IntegrationType {
  LINK // eigener E-Mail-Versand mit offiziellem Bewertungslink
  API // Plattform-API vorhanden
  EXTERNAL_PROGRAM // Plattform versendet selbst (z. B. Google Kundenrezensionen, Judge.me)
}

enum LegalBasis {
  NONE
  CONSENT // ausdrückliche Einwilligung (§ 7 Abs. 2 Nr. 2 UWG)
  UWG_7_3 // Bestandskundenausnahme (§ 7 Abs. 3 UWG)
}

enum ConsentStatus {
  GRANTED
  REVOKED
  OBJECTED
}

enum SuppressionReason {
  UNSUBSCRIBED
  HARD_BOUNCE
  OBJECTION
  COMPLAINT
  MANUAL
}

enum EmailEventType {
  QUEUED
  SENT
  FAILED
  BOUNCED_SOFT
  BOUNCED_HARD
  CLICKED
  UNSUBSCRIBED
  TEST_SENT
}

enum ReviewEventType {
  REVIEW_CONFIRMED
  REVIEW_MARKED_MANUALLY
  LINK_CLICKED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  DEAD
}

enum UserRole {
  OWNER
  ADMIN
  VIEWER
}

// ───────────────────────────── Mandant ─────────────────────────────

model Shop {
  id             String    @id @default(uuid()) @db.Uuid
  shopifyDomain  String    @unique @map("shopify_domain") // xyz.myshopify.com
  shopifyShopId  String?   @unique @map("shopify_shop_id")
  name           String
  timezone       String    @default("Europe/Berlin")
  currency       String    @default("EUR")
  plan           String    @default("internal") // SaaS-Vorbereitung
  installedAt    DateTime  @default(now()) @map("installed_at")
  uninstalledAt  DateTime? @map("uninstalled_at")
  lastOrderSyncAt DateTime? @map("last_order_sync_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  integrations     ShopIntegration[]
  customers        Customer[]
  orders           Order[]
  platforms        ReviewPlatform[]
  rule             ReviewRule?
  campaigns        ReviewCampaign[]
  templates        EmailTemplate[]
  consents         ConsentRecord[]
  suppressions     EmailSuppression[]
  webhooks         WebhookEvent[]
  auditLogs        AuditLog[]
  channelMappings  ChannelMappingRule[]
  users            User[]
  reviewEvents     ReviewEvent[]

  @@map("shops")
}

model ShopIntegration {
  id              String   @id @default(uuid()) @db.Uuid
  shopId          String   @map("shop_id") @db.Uuid
  provider        String // "judgeme" | "smtp" | ...
  encryptedConfig String?  @map("encrypted_config") // AES-256-GCM (siehe src/lib/crypto.ts)
  status          String   @default("NOT_CONFIGURED") // NOT_CONFIGURED | OK | ERROR | UNSUPPORTED
  statusDetail    String?  @map("status_detail")
  lastCheckedAt   DateTime? @map("last_checked_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, provider])
  @@map("shop_integrations")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  shopId       String   @map("shop_id") @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("users")
}

// ───────────────────────────── Shopify-Daten ─────────────────────────────

model Customer {
  id               String   @id @default(uuid()) @db.Uuid
  shopId           String   @map("shop_id") @db.Uuid
  shopifyCustomerId String  @map("shopify_customer_id")
  email            String?
  firstName        String?  @map("first_name")
  lastName         String?  @map("last_name")
  locale           String?
  marketingState   String?  @map("marketing_state") // Shopify CustomerEmailAddressMarketingState
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  shop             Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders           Order[]

  @@unique([shopId, shopifyCustomerId])
  @@index([shopId, email])
  @@map("customers")
}

model Order {
  id                 String          @id @default(uuid()) @db.Uuid
  shopId             String          @map("shop_id") @db.Uuid
  shopifyOrderId     String          @map("shopify_order_id") // gid://shopify/Order/…
  name               String // "#1001"
  orderNumber        Int?            @map("order_number")
  orderCreatedAt     DateTime        @map("order_created_at")
  customerId         String?         @map("customer_id") @db.Uuid
  email              String?
  firstName          String?         @map("first_name")
  lastName           String?         @map("last_name")
  locale             String?
  totalPrice         Decimal         @map("total_price") @db.Decimal(12, 2)
  totalRefunded      Decimal         @default(0) @map("total_refunded") @db.Decimal(12, 2)
  currency           String          @default("EUR")
  financialStatus    String?         @map("financial_status")
  fulfillmentStatus  String?         @map("fulfillment_status")
  returnStatus       String?         @map("return_status")
  cancelledAt        DateTime?       @map("cancelled_at")
  sourceName         String?         @map("source_name")
  shippingMethod     String?         @map("shipping_method")
  isTest             Boolean         @default(false) @map("is_test")
  acceptsMarketing   Boolean         @default(false) @map("accepts_marketing")
  // Versand / Zustellung
  deliveryStatus     DeliveryStatus  @default(ORDER_RECEIVED) @map("delivery_status")
  deliverySource     DeliverySource? @map("delivery_source")
  shippedAt          DateTime?       @map("shipped_at")
  deliveredAt        DateTime?       @map("delivered_at")
  hasTracking        Boolean         @default(false) @map("has_tracking")
  carrier            String?
  isFreight          Boolean         @default(false) @map("is_freight")
  // Herkunft
  channel            SalesChannel    @default(UNKNOWN)
  channelMethod      String?         @map("channel_method") // utm_source | referrer | landing_page | source_name | none
  channelConfidence  AttributionConfidence @default(NONE) @map("channel_confidence")
  // Sperre für Bewertungsanfragen (z. B. Kundenwunsch) – nie zur Unterdrückung negativer Bewertungen
  reviewBlocked      Boolean         @default(false) @map("review_blocked")
  reviewBlockedReason String?        @map("review_blocked_reason")
  shopifyUpdatedAt   DateTime?       @map("shopify_updated_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  shop         Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer     Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  fulfillments Fulfillment[]
  attribution  AttributionSource?
  campaign     ReviewCampaign?
  reviewEvents ReviewEvent[]

  @@unique([shopId, shopifyOrderId])
  @@index([shopId, orderCreatedAt])
  @@index([shopId, deliveryStatus])
  @@map("orders")
}

model OrderItem {
  id               String  @id @default(uuid()) @db.Uuid
  orderId          String  @map("order_id") @db.Uuid
  shopifyLineItemId String @map("shopify_line_item_id")
  title            String
  sku              String?
  quantity         Int
  shopifyProductId String? @map("shopify_product_id")
  unitPrice        Decimal? @map("unit_price") @db.Decimal(12, 2)
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, shopifyLineItemId])
  @@map("order_items")
}

model Fulfillment {
  id                   String    @id @default(uuid()) @db.Uuid
  orderId              String    @map("order_id") @db.Uuid
  shopifyFulfillmentId String    @map("shopify_fulfillment_id")
  status               String // Shopify FulfillmentStatus
  displayStatus        String?   @map("display_status") // Shopify FulfillmentDisplayStatus
  carrier              String?
  trackingNumber       String?   @map("tracking_number")
  trackingUrl          String?   @map("tracking_url")
  shippedAt            DateTime  @map("shipped_at")
  inTransitAt          DateTime? @map("in_transit_at")
  deliveredAt          DateTime? @map("delivered_at")
  estimatedDeliveryAt  DateTime? @map("estimated_delivery_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  order                Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trackingEvents       TrackingEvent[]

  @@unique([orderId, shopifyFulfillmentId])
  @@map("fulfillments")
}

model TrackingEvent {
  id             String         @id @default(uuid()) @db.Uuid
  fulfillmentId  String         @map("fulfillment_id") @db.Uuid
  externalId     String         @map("external_id") // Shopify FulfillmentEvent-ID oder "manual:<uuid>"
  source         DeliverySource
  status         String // Rohstatus der Quelle
  happenedAt     DateTime       @map("happened_at")
  message        String?
  createdAt      DateTime       @default(now()) @map("created_at")
  fulfillment    Fulfillment    @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)

  @@unique([fulfillmentId, externalId])
  @@map("tracking_events")
}

// Rohdaten der Attribution pro Bestellung (keine erfundenen Werte – nur, was Shopify liefert)
model AttributionSource {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @unique @map("order_id") @db.Uuid
  sourceName     String?  @map("source_name")
  referrerUrl    String?  @map("referrer_url")
  landingPage    String?  @map("landing_page")
  utmSource      String?  @map("utm_source")
  utmMedium      String?  @map("utm_medium")
  utmCampaign    String?  @map("utm_campaign")
  visitSource    String?  @map("visit_source")
  raw            Json?
  createdAt      DateTime @default(now()) @map("created_at")
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("attribution_sources")
}

// Konfigurierbare Mapping-Tabelle für die Kanalerkennung
model ChannelMappingRule {
  id        String       @id @default(uuid()) @db.Uuid
  shopId    String       @map("shop_id") @db.Uuid
  field     String // utm_source | utm_medium | referrer_host | landing_page | source_name
  pattern   String // Teilstring (case-insensitiv)
  channel   SalesChannel
  priority  Int          @default(100) // kleiner = zuerst
  active    Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at")
  shop      Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, field, pattern])
  @@map("channel_mapping_rules")
}

// ───────────────────────────── Bewertungen ─────────────────────────────

model ReviewPlatform {
  id                   String          @id @default(uuid()) @db.Uuid
  shopId               String          @map("shop_id") @db.Uuid
  key                  PlatformKey
  name                 String
  active               Boolean         @default(false)
  reviewUrl            String?         @map("review_url")
  integrationType      IntegrationType @map("integration_type")
  apiAvailable         Boolean         @default(false) @map("api_available")
  statusQueryAvailable Boolean         @default(false) @map("status_query_available")
  remindersAllowed     Boolean         @default(false) @map("reminders_allowed")
  priority             Int             @default(100)
  targetShare          Int             @default(0) @map("target_share") // Prozent
  extraDelayDays       Int             @default(0) @map("extra_delay_days")
  onlyForChannels      SalesChannel[]  @map("only_for_channels") // leer = alle Bestellungen
  notes                String?
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  shop                 Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  campaigns            ReviewCampaign[]
  reviewEvents         ReviewEvent[]
  templates            EmailTemplate[]

  @@unique([shopId, key])
  @@map("review_platforms")
}

// Versand- und Rechtseinstellungen pro Shop
model ReviewRule {
  id                          String     @id @default(uuid()) @db.Uuid
  shopId                      String     @unique @map("shop_id") @db.Uuid
  firstRequestDaysAfterDelivery Int      @default(4) @map("first_request_days_after_delivery") // 3–5
  fallbackDaysAfterOrder      Int        @default(14) @map("fallback_days_after_order")
  reminderIntervalDays        Int        @default(3) @map("reminder_interval_days")
  maxAttempts                 Int        @default(3) @map("max_attempts")
  sendWindowStartHour         Int        @default(9) @map("send_window_start_hour")
  sendWindowEndHour           Int        @default(19) @map("send_window_end_hour")
  timezone                    String     @default("Europe/Berlin")
  dailySendLimit              Int        @default(200) @map("daily_send_limit")
  freightPatterns             String[]   @default(["spedition", "freight", "dachser", "schenker", "hellmann", "rhenus", "kühne", "kuehne"]) @map("freight_patterns")
  legalBasis                  LegalBasis @default(NONE) @map("legal_basis")
  // Produktivfreigabe: erst nach ausdrücklicher Freigabe durch einen Admin (siehe /api/settings/release)
  sendingEnabled              Boolean    @default(false) @map("sending_enabled")
  sendingReleasedAt           DateTime?  @map("sending_released_at")
  sendingReleasedBy           String?    @map("sending_released_by")
  remindersOnUnknownStatus    Boolean    @default(false) @map("reminders_on_unknown_status")
  // Entscheidung Adfunture (11.11.2026): jede versendete Bestellung erhält eine Anfrage – auch erstattete/retournierte
  includeRefundedOrders       Boolean    @default(true) @map("include_refunded_orders")
  uwgNoticeConfirmedAt        DateTime?  @map("uwg_notice_confirmed_at")
  considerJudgemeInvitations  Boolean    @default(true) @map("consider_judgeme_invitations")
  testRecipients              String[]   @default([]) @map("test_recipients")
  createdAt                   DateTime   @default(now()) @map("created_at")
  updatedAt                   DateTime   @updatedAt @map("updated_at")
  shop                        Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("review_rules")
}

// Höchstens EINE Kampagne pro Bestellung (plattformübergreifend)
model ReviewCampaign {
  id            String         @id @default(uuid()) @db.Uuid
  shopId        String         @map("shop_id") @db.Uuid
  orderId       String         @unique @map("order_id") @db.Uuid
  platformId    String?        @map("platform_id") @db.Uuid
  status        CampaignStatus @default(PENDING)
  statusReason  String?        @map("status_reason")
  shippingRule  ShippingRule?  @map("shipping_rule")
  anchorAt      DateTime?      @map("anchor_at") // Zustellung (A) bzw. Bestellung (B)
  reviewStatus  ReviewStatus   @default(UNKNOWN) @map("review_status")
  pausedAt      DateTime?      @map("paused_at")
  closedAt      DateTime?      @map("closed_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  platform      ReviewPlatform? @relation(fields: [platformId], references: [id], onDelete: SetNull)
  invitations   ReviewInvitation[]
  reviewEvents  ReviewEvent[]

  @@index([shopId, status])
  @@map("review_campaigns")
}

// Höchstens eine Einladung pro Kampagnenstufe
model ReviewInvitation {
  id            String           @id @default(uuid()) @db.Uuid
  campaignId    String           @map("campaign_id") @db.Uuid
  step          Int // 1, 2, 3
  manual        Boolean          @default(false) // manuell ausgelöste Erinnerung (Dashboard)
  scheduledAt   DateTime         @map("scheduled_at")
  status        InvitationStatus @default(SCHEDULED)
  statusReason  String?          @map("status_reason")
  attempts      Int              @default(0)
  nextAttemptAt DateTime?        @map("next_attempt_at")
  lastError     String?          @map("last_error")
  sentAt        DateTime?        @map("sent_at")
  messageId     String?          @map("message_id")
  trackingToken String           @unique @default(uuid()) @map("tracking_token")
  firstClickedAt DateTime?       @map("first_clicked_at")
  clickCount    Int              @default(0) @map("click_count")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  campaign      ReviewCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  emailEvents   EmailEvent[]

  @@unique([campaignId, step])
  @@index([status, scheduledAt])
  @@map("review_invitations")
}

model ReviewEvent {
  id          String          @id @default(uuid()) @db.Uuid
  shopId      String          @map("shop_id") @db.Uuid
  platformId  String?         @map("platform_id") @db.Uuid
  orderId     String?         @map("order_id") @db.Uuid
  campaignId  String?         @map("campaign_id") @db.Uuid
  type        ReviewEventType
  externalId  String?         @map("external_id") // z. B. Judge.me Review-ID
  rating      Int?
  occurredAt  DateTime        @map("occurred_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  shop        Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  platform    ReviewPlatform? @relation(fields: [platformId], references: [id], onDelete: SetNull)
  order       Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  campaign    ReviewCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([shopId, platformId, externalId])
  @@index([shopId, occurredAt])
  @@map("review_events")
}

model EmailTemplate {
  id          String          @id @default(uuid()) @db.Uuid
  shopId      String          @map("shop_id") @db.Uuid
  platformId  String?         @map("platform_id") @db.Uuid // null = Standardvorlage
  scope       String          @default("default") // "default" oder Plattform-Key
  step        Int
  subject     String
  bodyText    String          @map("body_text")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  shop        Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  platform    ReviewPlatform? @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([shopId, scope, step])
  @@map("email_templates")
}

model EmailEvent {
  id           String          @id @default(uuid()) @db.Uuid
  invitationId String?         @map("invitation_id") @db.Uuid
  shopId       String          @map("shop_id") @db.Uuid
  type         EmailEventType
  detail       String?
  occurredAt   DateTime        @default(now()) @map("occurred_at")
  invitation   ReviewInvitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([shopId, type, occurredAt])
  @@map("email_events")
}

model ConsentRecord {
  id         String        @id @default(uuid()) @db.Uuid
  shopId     String        @map("shop_id") @db.Uuid
  email      String
  status     ConsentStatus
  source     String // shopify_marketing_state | checkout_checkbox | unsubscribe_link | manual
  detail     String?
  recordedAt DateTime      @default(now()) @map("recorded_at")
  shop       Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, email, recordedAt])
  @@map("consent_records")
}

model EmailSuppression {
  id        String            @id @default(uuid()) @db.Uuid
  shopId    String            @map("shop_id") @db.Uuid
  email     String
  reason    SuppressionReason
  createdAt DateTime          @default(now()) @map("created_at")
  shop      Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, email])
  @@map("email_suppressions")
}

model WebhookEvent {
  id          String        @id @default(uuid()) @db.Uuid
  shopId      String?       @map("shop_id") @db.Uuid
  webhookId   String        @unique @map("webhook_id") // X-Shopify-Webhook-Id → Idempotenz
  eventId     String?       @map("event_id") // X-Shopify-Event-Id
  topic       String
  payload     Json
  status      WebhookStatus @default(RECEIVED)
  error       String?
  receivedAt  DateTime      @default(now()) @map("received_at")
  processedAt DateTime?     @map("processed_at")
  shop        Shop?         @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([status, receivedAt])
  @@map("webhook_events")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String?  @map("shop_id") @db.Uuid
  actor     String // user:<id> | system | worker | webhook
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  data      Json?
  createdAt DateTime @default(now()) @map("created_at")
  shop      Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@map("audit_logs")
}

// Persistente Job-Queue (PostgreSQL, FOR UPDATE SKIP LOCKED) – übersteht Neustarts
model Job {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  payload     Json      @default("{}")
  status      JobStatus @default(PENDING)
  runAt       DateTime  @default(now()) @map("run_at")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  lastError   String?   @map("last_error")
  lockedAt    DateTime? @map("locked_at")
  lockedBy    String?   @map("locked_by")
  dedupeKey   String?   @unique @map("dedupe_key")
  createdAt   DateTime  @default(now()) @map("created_at")
  finishedAt  DateTime? @map("finished_at")

  @@index([status, runAt])
  @@map("jobs")
}

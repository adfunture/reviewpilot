# ReviewPilot – Umgebungsvariablen (Beispiel). Keine echten Werte einchecken!

NODE_ENV=production
PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgresql://user:pass@host:5432/railway

# Öffentliche HTTPS-Adresse des Web-Service (für Klick- und Abmeldelinks in E-Mails)
PUBLIC_BASE_URL=https://reviews.adfunture.de
COOKIE_SECURE=true

# 32 Byte base64: `node dist/cli.js generate-key` – zusätzlich offline sichern (Verlust = Judge.me-Token neu eingeben)
ENCRYPTION_KEY=
# mind. 32 zufällige Zeichen (signiert Sessions und Abmeldelinks)
SESSION_SECRET=

# Shopify Dev-Dashboard-App (Client Credentials Grant, Scopes: read_orders, read_customers, read_fulfillments)
SHOPIFY_SHOP_DOMAIN=2zd4sv-jw.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Alternative für eine im Shopify-Admin erstellte Custom App: festes Admin-API-Zugriffstoken (shpat_…).
# Dann wird kein Token angefragt; SHOPIFY_CLIENT_SECRET = „API-Geheimschlüssel“ (shpss_…) für Webhooks.
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10

# E-Mail: "log" versendet nichts (nur Protokoll). "smtp" erst nach SPF/DKIM/DMARC-Prüfung.
EMAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Adfunture <bewertung@adfunture.de>"
EMAIL_REPLY_TO=info@adfunture.de
# Optional: geteiltes Geheimnis für POST /webhooks/email-bounce (Header X-ReviewPilot-Secret)
BOUNCE_WEBHOOK_SECRET=

# Harte Sicherung: ohne "true" verlässt keine Kunden-E-Mail das System (zusätzlich zur Freigabe im Dashboard)
ALLOW_CUSTOMER_EMAILS=false

# Worker im Web-Prozess mitlaufen lassen (spart einen Railway-Service)
RUN_WORKER_IN_WEB=false
WORKER_POLL_MS=5000
